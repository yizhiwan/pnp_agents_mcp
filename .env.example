# =============================================================================
# Compose-level environment. Copy to `.env` on each station and fill in.
#   cp .env.example .env
# Only this file and env/<station>.yaml differ between stations.
# Every value below has a safe default in compose.yaml except the secrets.
# =============================================================================

# --- Which station overlay to load (env/<station>.yaml) ----------------------
STATION=local
COMPOSE_PROJECT_NAME=pnp-agents-mcp

# --- Gateway (LiteLLM) -------------------------------------------------------
# Master key clients must present to the gateway. REQUIRED. Generate one:
#   openssl rand -hex 24
GATEWAY_MASTER_KEY=
# Set GATEWAY_PROFILE=external to skip the bundled gateway container and point
# the orchestrator at an existing gateway via GATEWAY_BASE_URL.
GATEWAY_PROFILE=bundled
GATEWAY_BASE_URL=
GATEWAY_HOST=gateway
GATEWAY_PORT=4000
# Host interface the published port binds to. Use 0.0.0.0 to expose publicly.
GATEWAY_BIND_HOST=127.0.0.1

# --- Provider credentials ----------------------------------------------------
# Supply keys only for the aliases you actually use. The gateway refuses to
# start if an enabled alias has no key. Leave the rest empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional provider base URLs (self-hosted / proxied / regional endpoints).
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama for the `local-llama` alias. Inside compose on Linux, reach the host
# with http://host.docker.internal:11434 (extra_hosts is already wired).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Comma-separated aliases the gateway should serve. Empty = all of them.
GATEWAY_ENABLED_ALIASES=

# --- MCP tools server --------------------------------------------------------
MCP_TRANSPORT=http
MCP_HOST=tools-server
TOOLS_SERVER_PORT=8081
TOOLS_SERVER_BIND_HOST=127.0.0.1

# Web search backend for the search_web tool: tavily | brave | searxng | none
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_BASE_URL=

# run_shell_safe: allowlisted binaries only. Empty ALLOWLIST disables the tool.
SHELL_ENABLED=true
SHELL_ALLOWLIST=echo,ls,cat,pwd,whoami,date,uname,df,uptime
SHELL_TIMEOUT_SECONDS=15

# --- Orchestrator ------------------------------------------------------------
ORCHESTRATOR_PORT=8080
ORCHESTRATOR_BIND_HOST=127.0.0.1

# --- Model aliases per agent (must exist in gateway/litellm_config.yaml) -----
RESEARCHER_MODEL_ALIAS=claude-sonnet
CODER_MODEL_ALIAS=gpt-4o
REVIEWER_MODEL_ALIAS=claude-haiku

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Images ------------------------------------------------------------------
PYTHON_IMAGE=python:3.12-slim
IMAGE_PREFIX=pnp-agents-mcp
IMAGE_TAG=1.0.0
